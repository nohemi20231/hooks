{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/scan-push-pii.py",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "Scanning outgoing commits for secrets and personal data"
          }
        ]
      }
    ]
  }
}
